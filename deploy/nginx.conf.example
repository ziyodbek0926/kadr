# Ishlab chiqarish uchun namuna: TLS tugatuvchi teskari-proksi (reverse proxy).
# Bu konfiguratsiya tashkilot tarmog'ining tashqi chegarasida turadi; frontend/backend
# konteynerlarining docker-compose.yml'dagi portlari esa faqat 127.0.0.1'ga bog'langan —
# ya'ni ular shu serverning o'zidan tashqarida to'g'ridan-to'g'ri ko'rinmaydi.
#
# Ishlatish: /etc/nginx/sites-available/kadr.conf'ga nusxalab, sertifikat yo'llarini
# to'g'rilang (masalan Let's Encrypt yoki tashkilot IChK sertifikati bilan).

server {
    listen 80;
    server_name kadr.example.local;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name kadr.example.local;

    ssl_certificate     /etc/nginx/certs/kadr.crt;
    ssl_certificate_key /etc/nginx/certs/kadr.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    client_max_body_size 15M;

    location / {
        proxy_pass http://127.0.0.1:5173;
        proxy_set_header Host $host;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
