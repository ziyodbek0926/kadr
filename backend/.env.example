ENVIRONMENT=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kadr_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kadr

# Generatsiya qilish: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-real-random-secret

# Generatsiya qilish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

BACKEND_CORS_ORIGINS=["http://localhost:5173"]

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

LOGIN_RATE_LIMIT=5/minute
