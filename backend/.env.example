ENVIRONMENT=development

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=kadr_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kadr

# Generatsiya qilish: openssl rand -hex 32
SECRET_KEY=change-me-generate-a-real-random-secret

# Generatsiya qilish: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# http://tauri.localhost — Windows'da Tauri desktop-wrapper WebView2'ning haqiqiy kelib
# chiqish (Origin) manzili (tekshirilgan; https:// EMAS, http://). macOS/Linux uchun esa
# tauri://localhost. Buni olib tashlasangiz, desktop-ilova login so'rovini yubora olmaydi
# (backend log'ida "OPTIONS /auth/login ... 400 Bad Request" ko'rinadi).
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://tauri.localhost","tauri://localhost"]

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

LOGIN_RATE_LIMIT=5/minute
