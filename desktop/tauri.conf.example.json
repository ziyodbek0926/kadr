{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadr",
  "version": "0.1.0",
  "identifier": "uz.gov.kadr.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Kadr — Kadrlar boshqaruvi tizimi",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:8000 https://kadr.example.local"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "minimumSystemVersion": "10",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
